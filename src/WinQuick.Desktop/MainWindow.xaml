<Window x:Class="WinQuick.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WINQUICK" Height="820" Width="1440" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,24,18,18">
                    <TextBlock Text="WINQUICK" Foreground="White" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Gestão &amp; POS" Foreground="#9CA3AF" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Content="▦   Dashboard" Click="Dashboard_Click" />
                    <Button Style="{StaticResource NavButton}" Content="▣   Ponto de Venda" Click="Pos_Click" />
                    <Button Style="{StaticResource NavButton}" Content="□   Produtos" Click="Products_Click" />
                    <Button Style="{StaticResource NavButton}" Content="◇   Stock" Click="Stock_Click" />
                    <Button Style="{StaticResource NavButton}" Content="♙   Clientes" Click="Customers_Click" />
                    <Button Style="{StaticResource NavButton}" Content="▤   Compras" Click="Purchases_Click" />
                    <Button Style="{StaticResource NavButton}" Content="▥   Facturação" Click="Invoices_Click" />
                    <Button Style="{StaticResource NavButton}" Content="◷   Caixa" Click="Cash_Click" />
                    <Button Style="{StaticResource NavButton}" Content="☷   Relatórios" Click="Reports_Click" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" Background="#1F2937" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="OPERADOR" Foreground="#9CA3AF" FontSize="10" />
                        <TextBlock Text="Sessão activa" Foreground="White" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="PageSubtitle" Text="Visão geral da operação" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="+ Nova venda" Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="22,12" Click="Pos_Click" />
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,22">
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="Vendas hoje" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="MT 0,00" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="5,0,10,0">
                    <StackPanel><TextBlock Text="Facturas" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="0" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="5,0,10,0">
                    <StackPanel><TextBlock Text="Stock baixo" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="0" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="5,0,0,0">
                    <StackPanel><TextBlock Text="Caixa" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="Fechado" FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="24">
                <Grid>
                    <StackPanel x:Name="DashboardContent">
                        <TextBlock Text="Bem-vindo ao WINQUICK" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Use o menu para entrar no POS, gerir produtos, stock, clientes, compras, facturação e caixa." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,24" />
                        <Border Background="#F0FDF4" CornerRadius="10" Padding="16">
                            <StackPanel><TextBlock Text="Sistema pronto para operação" FontWeight="SemiBold" Foreground="#166534"/><TextBlock Text="A interface está ligada à estrutura modular do WINQUICK e será expandida por módulo." Foreground="#166534" Margin="0,5,0,0"/></StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
