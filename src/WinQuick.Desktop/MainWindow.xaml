<Window x:Class="WinQuick.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WINQUICK — Gestão &amp; POS" Height="900" Width="1540" MinHeight="760" MinWidth="1180" WindowStartupLocation="CenterScreen" Background="{StaticResource PageBackground}">
<Window.Resources><Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBackground}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/></Style><Style x:Key="StatValue" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Style></Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource SidebarBackground}"><DockPanel LastChildFill="True"><Border DockPanel.Dock="Top" Padding="22,24,22,22"><StackPanel><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryBrush}"><TextBlock Text="W" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="WINQUICK" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock Text="GESTÃO &amp; POS" Foreground="{StaticResource SidebarMuted}" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></StackPanel></StackPanel></Border>
<StackPanel><TextBlock Text="PRINCIPAL" Foreground="#667085" FontSize="9" FontWeight="Bold" Margin="23,7,0,6"/><Button Style="{StaticResource NavButton}" Content="▦   Dashboard" Click="Dashboard_Click"/><Button Style="{StaticResource NavButton}" Content="▣   Ponto de Venda" Click="Pos_Click"/><TextBlock Text="GESTÃO" Foreground="#667085" FontSize="9" FontWeight="Bold" Margin="23,18,0,6"/><Button Style="{StaticResource NavButton}" Content="□   Produtos" Click="Products_Click"/><Button Style="{StaticResource NavButton}" Content="◇   Stock" Click="Stock_Click"/><Button Style="{StaticResource NavButton}" Content="♙   Clientes" Click="Customers_Click"/><Button Style="{StaticResource NavButton}" Content="▤   Compras" Click="Purchases_Click"/><TextBlock Text="FINANCEIRO" Foreground="#667085" FontSize="9" FontWeight="Bold" Margin="23,18,0,6"/><Button Style="{StaticResource NavButton}" Content="▥   Facturação" Click="Invoices_Click"/><Button Style="{StaticResource NavButton}" Content="◷   Caixa" Click="Cash_Click"/><Button Style="{StaticResource NavButton}" Content="☷   Relatórios" Click="Reports_Click"/><TextBlock Text="ADMINISTRAÇÃO" Foreground="#667085" FontSize="9" FontWeight="Bold" Margin="23,18,0,6"/><Button Style="{StaticResource NavButton}" Content="⚙   Utilizadores" Click="Users_Click"/></StackPanel>
<Border DockPanel.Dock="Bottom" Margin="13" Padding="13" Background="#121C2D" CornerRadius="11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="#243247"><TextBlock Text="O" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="OPERADOR" Foreground="#7F8EA3" FontSize="9" FontWeight="Bold"/><TextBlock Text="Sessão activa" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel><Ellipse Grid.Column="2" Width="8" Height="8" Fill="#12B76A" VerticalAlignment="Center"/></Grid></Border></DockPanel></Border>
<Grid Grid.Column="1" Margin="34,28,34,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,25"><StackPanel HorizontalAlignment="Left"><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><TextBlock x:Name="PageSubtitle" Text="Visão geral da operação" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Width="210" Height="40" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Margin="0,0,10,0"><TextBlock Text="⌕  Pesquisar..." Foreground="#98A2B3" VerticalAlignment="Center" Margin="13,0"/></Border><Button Style="{StaticResource PrimaryButton}" Content="+  Nova venda" Click="Pos_Click"/></StackPanel></Grid>
<UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,22"><Border Style="{StaticResource Card}" Padding="19" Margin="0,0,8,0"><StackPanel><TextBlock Text="VENDAS HOJE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="MT 0,00" Style="{StaticResource StatValue}" Margin="0,8,0,2"/><TextBlock Text="Sem vendas registadas" FontSize="11" Foreground="#98A2B3"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="19" Margin="7,0,8,0"><StackPanel><TextBlock Text="FACTURAS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="0" Style="{StaticResource StatValue}" Margin="0,8,0,2"/><TextBlock Text="Emitidas hoje" FontSize="11" Foreground="#98A2B3"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="19" Margin="7,0,8,0"><StackPanel><TextBlock Text="STOCK BAIXO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="0" Style="{StaticResource StatValue}" Margin="0,8,0,2"/><TextBlock Text="Produtos a verificar" FontSize="11" Foreground="#98A2B3"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="19" Margin="7,0,0,0"><StackPanel><TextBlock Text="CAIXA" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/><TextBlock Text="Fechado" Style="{StaticResource StatValue}" FontSize="21" Margin="0,10,0,3"/><TextBlock Text="Nenhuma sessão activa" FontSize="11" Foreground="#98A2B3"/></StackPanel></Border></UniformGrid>
<Border Grid.Row="2" Style="{StaticResource Card}" Padding="23"><StackPanel><TextBlock Text="Desempenho de vendas" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="Ainda não existem vendas registadas." Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0"/></StackPanel></Border></Grid></Grid></Window>