<Window x:Class="WinQuick.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WINQUICK — Iniciar sessão" Width="480" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F7F8FA">
    <Grid Margin="42">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" Margin="0,22,0,0">
            <Border Width="62" Height="62" CornerRadius="16" Background="#16A34A" HorizontalAlignment="Center"><TextBlock Text="W" Foreground="White" FontSize="35" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="WINQUICK" FontSize="27" FontWeight="Bold" Foreground="#101828" HorizontalAlignment="Center" Margin="0,15,0,0"/>
            <TextBlock Text="Gestão &amp; POS" FontSize="12" Foreground="#667085" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="16" Padding="28" Margin="0,35,0,20">
            <StackPanel>
                <TextBlock Text="Iniciar sessão" FontSize="21" FontWeight="SemiBold" Foreground="#101828"/>
                <TextBlock Text="Entre com a sua conta para continuar." Foreground="#667085" FontSize="12" Margin="0,5,0,25"/>
                <TextBlock Text="Utilizador" FontSize="11" FontWeight="SemiBold" Foreground="#344054"/>
                <TextBox x:Name="UsernameBox" Height="42" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" Margin="0,7,0,17" Text="Admin"/>
                <TextBlock Text="Senha" FontSize="11" FontWeight="SemiBold" Foreground="#344054"/>
                <PasswordBox x:Name="PasswordBox" Height="42" Padding="12,0" FontSize="14" VerticalContentAlignment="Center" Margin="0,7,0,10"/>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#D92D20" FontSize="11" Margin="0,4,0,10" Visibility="Collapsed"/>
                <Button Content="Entrar" Height="44" Background="#16A34A" Foreground="White" FontWeight="SemiBold" FontSize="14" Click="Login_Click"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="WINQUICK • Acesso seguro" Foreground="#98A2B3" FontSize="10" HorizontalAlignment="Center"/>
    </Grid>
</Window>
