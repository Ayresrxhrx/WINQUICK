<Window x:Class="WinQuick.Desktop.Stock.StockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WINQUICK — Stock" Width="1280" Height="800" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F7F8FA"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Stock" FontSize="28" FontWeight="Bold" Foreground="#101828"/><TextBlock Text="Existências e ajustes" Foreground="#667085" Margin="0,5,0,0"/></StackPanel><Button Content="Ajustar stock" HorizontalAlignment="Right" Padding="18,11" Background="#16A34A" Foreground="White" FontWeight="SemiBold" Click="Adjust_Click"/></Grid><Border Grid.Row="1" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,16"><TextBox x:Name="SearchBox" Height="38" BorderThickness="0" Background="#F9FAFB" Padding="12" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" /></Border><Border Grid.Row="2" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="14"><DataGrid x:Name="StockGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="52"><DataGrid.Columns><DataGridTextColumn Header="PRODUTO" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="150"/><DataGridTextColumn Header="STOCK" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="130"/><DataGridTextColumn Header="DISPONÍVEL" Binding="{Binding Available, StringFormat={}{0:N2}}" Width="130"/><DataGridTextColumn Header="MÍNIMO" Binding="{Binding Minimum, StringFormat={}{0:N2}}" Width="120"/><DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid></Border></Grid></Window>