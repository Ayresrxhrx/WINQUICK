<Window x:Class="WinQuick.Desktop.Products.ProductsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WINQUICK — Produtos" Width="1320" Height="820" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#F7F8FA">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Produtos" FontSize="28" FontWeight="Bold" Foreground="#101828"/><TextBlock Text="Catálogo e preços" Foreground="#667085" Margin="0,5,0,0"/></StackPanel><Button Content="+  Novo produto" HorizontalAlignment="Right" Padding="18,11" Background="#16A34A" Foreground="White" FontWeight="SemiBold" Click="NewProduct_Click"/></Grid>
<Border Grid.Row="1" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Height="38" BorderThickness="0" Background="#F9FAFB" Padding="12" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/><ComboBox x:Name="StatusFilter" Grid.Column="1" Margin="10,0,0,0" Height="38" SelectionChanged="StatusFilter_SelectionChanged"><ComboBoxItem Content="Activos" IsSelected="True"/><ComboBoxItem Content="Todos"/></ComboBox><Button Grid.Column="2" Content="Actualizar" Margin="10,0,0,0" Background="#F2F4F7" Click="Refresh_Click"/></Grid></Border>
<Border Grid.Row="2" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="14"><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="52" SelectionChanged="ProductsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="PRODUTO" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/><DataGridTextColumn Header="PREÇO" Binding="{Binding SalePrice, StringFormat=MT {0:N2}}" Width="130"/><DataGridTextColumn Header="CUSTO" Binding="{Binding CostPrice, StringFormat=MT {0:N2}}" Width="130"/><DataGridCheckBoxColumn Header="STOCK" Binding="{Binding TrackStock}" Width="85"/><DataGridCheckBoxColumn Header="ACTIVO" Binding="{Binding IsActive}" Width="85"/></DataGrid.Columns></DataGrid></Border>
</Grid></Window>