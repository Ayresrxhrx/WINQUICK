<Window x:Class="WinQuick.Desktop.UsersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WINQUICK — Utilizadores" Width="900" Height="600" WindowStartupLocation="CenterOwner" Background="#F7F8FA">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Utilizadores" FontSize="26" FontWeight="Bold" Foreground="#101828"/><TextBlock Text="Contas e acesso ao WINQUICK" Foreground="#667085" Margin="0,4,0,18"/></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
<Border Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,12,0"><DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Utilizador" Binding="{Binding Username}" Width="*"/><DataGridTextColumn Header="Nome" Binding="{Binding DisplayName}" Width="*"/><DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="80"/></DataGrid.Columns></DataGrid></Border>
<Border Grid.Column="1" Background="White" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="Novo utilizador" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Utilizador" Margin="0,18,0,5"/><TextBox x:Name="UsernameBox" Height="38"/><TextBlock Text="Nome" Margin="0,12,0,5"/><TextBox x:Name="DisplayNameBox" Height="38"/><TextBlock Text="Senha" Margin="0,12,0,5"/><PasswordBox x:Name="PasswordBox" Height="38"/><TextBlock Text="Perfil" Margin="0,12,0,5"/><ComboBox x:Name="RoleBox" Height="38" DisplayMemberPath="Name"/><TextBlock x:Name="ErrorText" Foreground="#D92D20" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,8" Visibility="Collapsed"/><Button Content="Criar utilizador" Height="42" Background="#16A34A" Foreground="White" FontWeight="SemiBold" Click="Create_Click"/></StackPanel></Border>
</Grid></Grid></Window>