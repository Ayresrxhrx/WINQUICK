<Window x:Class="WinQuick.Desktop.Pos.PosWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WINQUICK — Ponto de Venda" Height="820" Width="1450" MinHeight="700" MinWidth="1100" WindowStartupLocation="CenterOwner" Background="#F6F7F9">
<Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="16" Padding="22" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock Text="Ponto de Venda" FontSize="25" FontWeight="Bold" Foreground="#101828"/><TextBlock Text="Registe vendas de forma rápida e simples" Foreground="#667085" Margin="0,4,0,0"/></StackPanel><Button Content="Limpar venda" HorizontalAlignment="Right" Padding="16,9" Background="#F2F4F7" Foreground="#344054" Click="ClearButton_Click"/></Grid>
<Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="10" Height="48" Margin="0,22,0,18"><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="14" Padding="14,0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/></Border>
<ScrollViewer Grid.Row="2"><ItemsControl x:Name="ProductsList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="205" Height="128" Margin="0,0,12,12" Background="White" BorderBrush="#EAECF0" BorderThickness="1" Click="Product_Click"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#101828" TextWrapping="Wrap"/><TextBlock Text="{Binding Sku}" Foreground="#98A2B3" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="{Binding SalePrice, StringFormat=MT {0:N2}}" Foreground="#16A34A" FontSize="16" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
<Border Grid.Column="1" Background="#0B1220" CornerRadius="16" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Venda actual" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock Text="Consumidor final" Foreground="#8B97A8" FontSize="12" Margin="0,4,0,0"/></StackPanel><ScrollViewer Grid.Row="1" Margin="0,20,0,18"><ItemsControl x:Name="CartList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#121C2D" CornerRadius="10" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Quantity, StringFormat={}{0:N0} un.}" Foreground="#8B97A8" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=MT {0:N2}}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Grid.Row="2"><Separator Background="#253247" Margin="0,0,0,15"/><Grid Margin="0,0,0,7"><TextBlock Text="Subtotal" Foreground="#8B97A8"/><TextBlock x:Name="SubtotalText" Text="MT 0,00" Foreground="White" HorizontalAlignment="Right"/></Grid><Grid Margin="0,0,0,12"><TextBlock Text="Desconto" Foreground="#8B97A8"/><TextBlock x:Name="DiscountText" Text="MT 0,00" Foreground="White" HorizontalAlignment="Right"/></Grid><Grid Margin="0,0,0,18"><TextBlock Text="TOTAL" Foreground="White" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="TotalText" Text="MT 0,00" Foreground="#4ADE80" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/></Grid><Button Content="PAGAR  →" Height="52" Background="#16A34A" Foreground="White" FontSize="15" FontWeight="Bold" Click="PayButton_Click"/></StackPanel></Grid></Border></Grid></Window>